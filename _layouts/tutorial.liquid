<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% include head.liquid %}
  </head>

  <!-- Body (no navbar) -->
  <body class="{% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Content -->
    <div class="container mt-5" role="main">
      {{ content }}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
